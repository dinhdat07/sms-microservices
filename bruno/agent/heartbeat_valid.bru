meta {
  name: heartbeat_valid
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/v1/agent/heartbeat
  body: json
  auth: none
}

headers {
  X-Master-Key: 0123456789abcdef0123456789abcdef
}

body:json {
  {
    "server_id": "test-agent-1",
    "timestamp": 1700000000
  }
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}
